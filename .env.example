# Mistral AI API Key (required for LLM summarization and RAG Q&A)
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (required for Hinglish speech-to-text translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# Model Selection
MISTRAL_MODEL=open-mistral-nemo
WHISPER_MODEL=base
SARVAM_STT_MODEL=saaras:v2.5

# Optional server-side yt-dlp cookies file. Do not upload this through the UI.
# YOUTUBE_COOKIES_FILE=/var/www/netaji/AI-video-Assistant/cookies.txt
# Optional when a specific runtime is installed on the VPS: deno, node, or qjs.
# YTDLP_JS_RUNTIME=deno
# Optional: use the same browser User-Agent used to export the cookies.
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...
