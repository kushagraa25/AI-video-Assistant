# Copy this file to .env and fill in your keys

# Mistral AI - summaries, action items and RAG chat (required)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-nemo

# Sarvam AI - Hinglish speech-to-text (required only for Hinglish)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# Optional: route YouTube downloads through a proxy if YouTube blocks your server's IP
# YOUTUBE_PROXY=socks5://127.0.0.1:40000
